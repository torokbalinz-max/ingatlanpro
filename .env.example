# Másold le ".env" néven, és töltsd ki. A .env NEM kerül GitHubra.

# Az alkalmazás adatbázisa (Neon connection string)
DATABASE_URL=postgresql://user:jelszo@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Migrációhoz (csak egyszer kell): honnan -> hova
SOURCE_DATABASE_URL=postgresql://user:jelszo@dpg-xxxx.frankfurt-postgres.render.com/ingatlan
TARGET_DATABASE_URL=postgresql://user:jelszo@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Belépés (a belépő ablakban: felhasználónév + jelszó)
#  ADMIN_* = te (mindent módosíthatsz)
#  APP_*   = régi közös belépés (nem kötelező; mostantól mindenki saját fiókot csinálhat)
#  Ha csak az APP_PASSWORD van megadva, az a belépés admin.
ADMIN_USER=admin
ADMIN_PASSWORD=
APP_USER=vendeg
APP_PASSWORD=

# Ezek az e-mail címek admin jogot kapnak, amikor regisztrálnak / Google-lel belépnek
# (vesszővel elválasztva) – pl. a saját Google fiókod
ADMIN_EMAILS=

# Fiókok
#  üresen        -> bárki böngészhet belépés nélkül (a feladáshoz, kedvencekhez kell fiók)
#  NYILVANOS=0   -> az oldal csak belépés után látszik
NYILVANOS=
#  MEGHIVO_KOD   -> ha megadod, csak ezzel a kóddal lehet regisztrálni (zárt kör)
MEGHIVO_KOD=
#  REGISZTRACIO=0 -> a regisztráció kikapcsolva (csak a meglévő fiókok léphetnek be)
REGISZTRACIO=

# Google belépés (nem kötelező) – console.cloud.google.com → OAuth kliens (Web),
# engedélyezett JavaScript forrás: https://ingatlanpro.onrender.com
GOOGLE_CLIENT_ID=

# E-mail értesítések (nem kötelező) – a Render ingyenes szerverén az SMTP tiltott,
# ezért HTTP-n küldünk. Legegyszerűbb: brevo.com (ingyen napi 300 levél,
# elég egy megerősített feladó cím, domain nem kell).
BREVO_API_KEY=
# vagy: RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=IngatlanPro
# Az oldal címe a levelekben lévő linkekhez (a Renderen magától megvan)
APP_URL=

# Figyelt oldalak automatikus futtatásához (cron-job.org) – hosszú, véletlen szöveg
CRON_KEY=

# AI-ellenőrzés az admin felületen (nem kötelező) – console.anthropic.com kulcs
ANTHROPIC_API_KEY=
